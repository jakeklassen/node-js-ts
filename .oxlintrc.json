{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    // This rule requires *deeply* readonly parameter types, which is
    // unsatisfiable for third-party class types: annotating a handler as
    // `Readonly<Context>` still fails, because `Readonly<T>` is shallow and we
    // don't own the declaration. Exempting the two types we receive but never
    // declare keeps the rule enforced everywhere we do own the signature.
    //
    // Deliberately NOT using `ignoreInferredTypes`, which would skip every
    // unannotated parameter — including our own contextually-typed callbacks,
    // where accidental mutation is most likely to slip through.
    "typescript/prefer-readonly-parameter-types": [
      "warn",
      {
        "allow": [
          { "from": "package", "package": "hono", "name": "Context" },
          { "from": "package", "package": "node:net", "name": "AddressInfo" }
        ]
      }
    ]
  },
  "env": {
    "builtin": true
  }
}
